cabal-version:      2.2
name:               g2-zoo
version:            0.1.0.0
synopsis:           Algebraic reverse mathematics around Gödel's second incompleteness theorem
description:        APS (Abstract Provability Structure) 周辺の代数的逆数学を Haskell で視覚化する。
                    .
                    型クラスとして PreOrder / Box / Diamond / PreAPS / APS / FixedPointAPS / LoebAPS
                    を提供し、G2 / FG2 / Loeb / FLoeb などの命題を有限モデル上で検査できる。
                    Graphviz dot 形式で Zoo 図を出力する。
license:            BSD-3-Clause
author:             jikokennobun
maintainer:         relativilyinnovation@gmail.com
build-type:         Simple
extra-source-files: README.md

common common-options
  default-language:   Haskell2010
  default-extensions: ScopedTypeVariables
                      FlexibleContexts
                      FlexibleInstances
                      GeneralizedNewtypeDeriving
                      DeriveAnyClass
                      LambdaCase
  ghc-options:        -Wall
                      -Wcompat
                      -Widentities
                      -Wincomplete-record-updates
                      -Wincomplete-uni-patterns
                      -Wpartial-fields
                      -Wredundant-constraints

library
  import:           common-options
  hs-source-dirs:   src
  exposed-modules:  G2Zoo
                    G2Zoo.PreOrder
                    G2Zoo.APS
                    G2Zoo.Properties
                    G2Zoo.Instances
                    G2Zoo.Zoo
                    G2Zoo.Search
                    G2Zoo.AutoZoo
                    G2Zoo.Algebra
                    G2Zoo.Report
                    G2Zoo.Classify
                    G2Zoo.Guide
                    G2Zoo.AlgebraHier
                    G2Zoo.G2Chain
  build-depends:    base >= 4.14 && < 5

executable g2-zoo
  import:           common-options
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    base >= 4.14 && < 5
                  , directory
                  , g2-zoo
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite g2-zoo-test
  import:           common-options
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  build-depends:    base >= 4.14 && < 5
                  , g2-zoo
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
